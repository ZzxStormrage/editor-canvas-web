{
  "name": "canvas-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Vue canvas editor built on LeaferJS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js src/composables/canvas-editor/*.test.js src/composables/canvas-editor/tests/*.test.js",
    "lint": "eslint src tests examples scripts --ext .js,.mjs,.vue",
    "check:public": "node scripts/check-public.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:public",
    "export:public": "node scripts/export-public.mjs",
    "prepack": "npm run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "nanoid": "^5.1.16",
    "vue": "^3.5.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.1.3"
  },
  "peerDependencies": {
    "@leafer-in/editor": "2.2.2",
    "@leafer-in/export": "2.2.2",
    "@leafer-in/interface": "2.2.2",
    "@leafer-in/resize": "2.2.2",
    "@leafer-in/text-editor": "2.2.2",
    "@leafer-ui/app": "2.2.2",
    "@leafer-ui/core": "2.2.2",
    "@leafer-ui/draw": "2.2.2",
    "leafer-ui": "2.2.2"
  },
  "devDependencies": {
    "@leafer-in/editor": "2.2.2",
    "@leafer-in/export": "2.2.2",
    "@leafer-in/interface": "2.2.2",
    "@leafer-in/resize": "2.2.2",
    "@leafer-in/text-editor": "2.2.2",
    "@leafer-ui/app": "2.2.2",
    "@leafer-ui/core": "2.2.2",
    "@leafer-ui/draw": "2.2.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "leafer-ui": "2.2.2",
    "sass": "^1.69.5",
    "vite": "^7.3.1",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
