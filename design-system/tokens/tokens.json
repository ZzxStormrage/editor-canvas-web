{
  "meta": {
    "name": "macos-canvas-design-system",
    "version": "1.0.0",
    "theme": "canvasLight"
  },
  "palette": {
    "background": {
      "hex": "#f5f5f7",
      "rgb": "245,245,247"
    },
    "on-background": {
      "hex": "#1d1d1f",
      "rgb": "29,29,31"
    },
    "surface": {
      "hex": "#ffffff",
      "rgb": "255,255,255"
    },
    "on-surface": {
      "hex": "#1d1d1f",
      "rgb": "29,29,31"
    },
    "primary": {
      "hex": "#007aff",
      "rgb": "0,122,255"
    },
    "on-primary": {
      "hex": "#ffffff",
      "rgb": "255,255,255"
    },
    "secondary": {
      "hex": "#5856d6",
      "rgb": "88,86,214"
    },
    "on-secondary": {
      "hex": "#ffffff",
      "rgb": "255,255,255"
    },
