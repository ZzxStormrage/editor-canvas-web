    },
    "primary-soft": {
      "hex": "#e8f2ff",
      "rgb": "232,242,255"
    },
    "rail": {
      "hex": "#e5e5ea",
      "rgb": "229,229,234"
    },
    "rail-border": {
      "hex": "#d1d1d6",
      "rgb": "209,209,214"
    },
    "panel": {
      "hex": "#ffffff",
      "rgb": "255,255,255"
    },
    "workspace": {
      "hex": "#ececf0",
      "rgb": "236,236,240"
    },
    "canvas": {
      "hex": "#f2f2f5",
      "rgb": "242,242,245"
    },
    "grid": {
      "hex": "#d9d9df",
