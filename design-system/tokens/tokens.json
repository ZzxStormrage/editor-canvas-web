    "muted": {
      "hex": "#636366",
      "rgb": "99,99,102"
    },
    "subtle": {
      "hex": "#8e8e93",
      "rgb": "142,142,147"
    },
    "line": {
      "hex": "#e3e3e8",
      "rgb": "227,227,232"
    },
    "outline": {
      "hex": "#aeaeb2",
      "rgb": "174,174,178"
    },
    "control": {
      "hex": "#f5f5f7",
      "rgb": "245,245,247"
    },
    "shadow": {
      "hex": "#1d1d1f",
      "rgb": "29,29,31"
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32
  },
  "metrics": {
    "controlHeight": 34,
    "iconButtonSize": 34,
    "fieldHeight": 36
  },
  "components": {
    "VBtn": {
      "rounded": "md",
      "variant": "flat",
      "density": "compact",
      "size": "small",
      "height": 34
    },
    "VBtnToggle": {
      "color": "primary",
      "density": "compact",
      "rounded": "md",
      "variant": "tonal"
    },
    "VChip": {
      "density": "compact",
      "rounded": "md",
      "size": "small"
    },
    "VSlider": {
      "color": "primary",
      "density": "compact",
      "hideDetails": true
    },
    "VTextField": {
      "density": "compact",
      "variant": "outlined",
      "bgColor": "surface",
      "color": "primary",
      "hideDetails": true,
      "rounded": "md"
    },
    "VColorInput": {
      "density": "compact",
      "variant": "outlined",
      "bgColor": "surface",
      "color": "primary",
      "hideDetails": true,
      "flat": true,
      "rounded": "md",
      "mode": "hex",
      "modes": [
        "hex"
      ],
      "hideActions": true,
      "hidePip": true,
      "showSwatches": true,
      "swatchesMaxHeight": 92,
      "swatches": [
        [
          "#111827",
          "#374151",
          "#6b7280",
          "#ffffff"
        ],
        [
          "#007aff",
          "#5ac8fa",
          "#5856d6",
          "#34c759"
        ],
        [
          "#ef4444",
          "#f59e0b",
          "#16a34a",
          "#ec4899"
        ]
      ]
    },
    "VNumberInput": {
      "reverse": false,
      "controlVariant": "default",
      "label": "",
      "hideInput": false,
      "inset": false,
      "variant": "solo-filled",
      "density": "compact",
      "bgColor": "surface",
      "color": "primary",
      "hideDetails": true,
      "flat": true,
      "rounded": 0,
      "VBtn": {
        "rounded": 0,
        "variant": "text"
      }
    },
    "VSelect": {
      "density": "compact",
      "variant": "outlined",
      "bgColor": "surface",
      "color": "primary",
      "hideDetails": true,
      "flat": true,
      "rounded": "md"
    }
  }
}
