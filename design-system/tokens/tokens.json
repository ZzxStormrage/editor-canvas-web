      "hex": "#ffffff",
      "rgb": "255,255,255"
    },
    "info": {
      "hex": "#2563eb",
      "rgb": "37,99,235"
    },
    "on-info": {
      "hex": "#ffffff",
      "rgb": "255,255,255"
